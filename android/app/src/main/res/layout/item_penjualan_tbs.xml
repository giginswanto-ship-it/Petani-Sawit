<?xml version="1.0" encoding="utf-8"?>
<!-- Item List Penjualan TBS (Arus Kas Masuk) dengan Bobot Adaptif & Target Sentuh >= 48dp -->
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_xsmall"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_contrast"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/min_touch_target_size"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemTglPanen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05/11"
                android:textSize="@dimen/text_body_regular"
                android:textStyle="bold"
                android:textColor="@color/sawit_primary" />

            <TextView
                android:id="@+id/tvItemRAM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_small"
                android:text="RAM Makmur Jaya"
                android:textSize="@dimen/text_body_regular"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_metric_box"
                android:paddingHorizontal="@dimen/spacing_xsmall"
                android:paddingVertical="@dimen/spacing_xxsmall"
                android:text="Lunas"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textColor="@color/status_untung" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemTonase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Netto: 2.450 Kg (Bruto 2.500 Kg, Pot 2%)"
                android:textSize="@dimen/text_body_small"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvItemTotalRp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 6.982.500"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:textColor="@color/sawit_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
