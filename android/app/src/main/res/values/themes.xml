<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PetaniSawit" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sawit_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/sawit_secondary</item>
        <item name="android:statusBarColor">@color/sawit_primary_variant</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Standar Ukuran Tombol Minimal 48dp x 48dp -->
        <item name="materialButtonStyle">@style/Widget.PetaniSawit.Button</item>
        <item name="textInputStyle">@style/Widget.PetaniSawit.TextInputLayout</item>
    </style>

    <style name="Widget.PetaniSawit.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target_size</item>
        <item name="android:minWidth">@dimen/min_touch_target_size</item>
        <item name="android:textSize">@dimen/text_body_regular</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.PetaniSawit.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/sawit_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
